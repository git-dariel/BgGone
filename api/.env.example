MODEL=silueta
DEVICE=cpu
EDGE_REFINEMENT=auto
WARM_MODEL=true
MAX_UPLOAD_MB=12
MAX_IMAGE_PIXELS=25000000
MAX_INFERENCE_SIDE=512
MAX_BATCH_SIZE=10
MAX_CONCURRENT_INFERENCE=1
BATCH_RETENTION_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
DATABASE_PATH=./data/keys.sqlite3
BATCH_DIRECTORY=./data/batches
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_TOKEN=change-this-long-random-secret
ANONYMOUS_RATE_PER_MINUTE=20
KEY_RATE_PER_MINUTE=120
KEY_MONTHLY_QUOTA=10000
REQUEST_TIMEOUT_SECONDS=120
